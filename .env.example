POSTGRES_DB=loanops
POSTGRES_USER=loanops
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/loanops
DATABASE_USERNAME=loanops
DATABASE_PASSWORD=replace-with-the-same-local-password
LOANOPS_API_ALLOWED_ORIGINS=http://localhost:5173

FSS_API_KEY=replace-with-fss-api-key
FSS_API_BASE_URL=https://finlife.fss.or.kr/finlifeapi
FSS_API_PATH=/mortgageLoanProductsSearch.json
FSS_TOP_FIN_GROUP_NO=020000
FSS_PAGE_NO=1
FSS_API_CONNECT_TIMEOUT=2s
FSS_API_READ_TIMEOUT=5s

SEOUL_API_KEY=replace-with-seoul-api-key
SEOUL_API_BASE_URL=http://openapi.seoul.go.kr:8088
SEOUL_API_SERVICE_NAME=dreamMoney
SEOUL_API_PAGE_SIZE=5
SEOUL_API_CONNECT_TIMEOUT=2s
SEOUL_API_READ_TIMEOUT=5s

# Open Banking: enable explicitly; no actual credentials belong in this file.
OPEN_BANKING_ENABLED=false
OPEN_BANKING_MODE=DEMO_REPLAY
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
OPEN_BANKING_REDIRECT_URI=
OPEN_BANKING_BASE_URL=
OPEN_BANKING_AUTHORIZATION_URI=
OPEN_BANKING_TOKEN_URI=
OPEN_BANKING_BANK_TRAN_PREFIX=
OPEN_BANKING_TEST_FINTECH_USE_NUM=
OPEN_BANKING_ENCRYPTION_KEY=
OPEN_BANKING_ENCRYPTION_KEY_ID=local-v1
OPEN_BANKING_OWNER_REF=local-operator
OPEN_BANKING_CONSENT_UNTIL=
OPEN_BANKING_ACTION=demo
OPEN_BANKING_CONNECTION_ID=
OPEN_BANKING_AUTHORIZATION_CODE=
OPEN_BANKING_OAUTH_STATE=
OPEN_BANKING_FROM_DATE=
OPEN_BANKING_TO_DATE=
OPEN_BANKING_RUN_ID=

# Phase 2 canonical layer: requires OPEN_BANKING_ENABLED and its encryption key.
PERSONAL_FINANCE_ENABLED=false
PERSONAL_BALANCE_STALE_AFTER=24h
PERSONAL_DQ_POLICY_VERSION=personal-dq-v1
